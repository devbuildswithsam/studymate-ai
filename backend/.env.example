# Copy to .env and fill in. Never commit .env.
ENV=development
AUTH_MODE=local
DATABASE_URL=sqlite:///./app.db
FRONTEND_ORIGIN=http://localhost:5173

# Free LLM providers (SMA-15)
GEMINI_API_KEY=
GROQ_API_KEY=

# Only for experiments/turso_spike (SMA-35, ADR-0006). The app doesn't use them.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
