# Copy to .env and fill in. Never commit .env.
ENV=development
AUTH_MODE=local
# Needed for AUTH_MODE=jwt (real accounts, SMA-57): at least 32 random characters. Make one:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
DATABASE_URL=sqlite:///./app.db
FRONTEND_ORIGIN=http://localhost:5173

# Free LLM providers (SMA-15)
GEMINI_API_KEY=
GROQ_API_KEY=

# Only for experiments/turso_spike (SMA-35, ADR-0006). The app doesn't use them.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
